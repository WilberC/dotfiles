#!/bin/sh
# Wrapper for op-ssh-sign that ensures SSH_TTY is set in remote sessions.
# When connecting via Zed's SSH remote, SSH_TTY may not be set even though
# the SSH agent is forwarded. op-ssh-sign requires both SSH_AUTH_SOCK and
# SSH_TTY to detect that it should use the forwarded agent for signing.

if [ -n "$SSH_CONNECTION" ] && [ -z "$SSH_TTY" ]; then
  export SSH_TTY=/dev/pts/0
fi

# op-ssh-sign only exists when the 1Password desktop app is installed
# locally (Linux desktops). Headless servers have no desktop app but do
# have a forwarded 1Password agent on $SSH_AUTH_SOCK, so fall back to
# ssh-keygen -Y — the same CLI surface op-ssh-sign implements — which
# signs through whatever agent SSH_AUTH_SOCK points at.
if [ -x /opt/1Password/op-ssh-sign ]; then
  exec /opt/1Password/op-ssh-sign "$@"
else
  exec ssh-keygen "$@"
fi
