
# 1Password desktop app is only present on Linux desktops, not headless
# servers — those instead rely on the forwarded agent at $SSH_AUTH_SOCK
# (see ForwardAgent in 01-base.conf), so only override when the socket
# actually exists.
Match exec "test -S %d/.1password/agent.sock"
  IdentityAgent ~/.1password/agent.sock

Include ~/.config/ssh/configs/*.conf
