#!/usr/bin/env bash
set -euo pipefail

# Bridges 1Password's Windows SSH agent (exposed as the standard Windows
# OpenSSH agent named pipe once "Use the SSH Agent" is enabled in the
# 1Password app) into a Unix socket inside WSL2, via npiperelay.exe + socat.
# Native WSL ssh points IdentityAgent at this socket (see os/wsl2/.ssh/config).

SOCK="$HOME/.1password/agent.sock"
PIPE="//./pipe/openssh-ssh-agent"

find_npiperelay() {
  # systemd --user units run with a minimal PATH (no Windows interop dirs
  # and no powershell.exe), so resolve purely via the filesystem.
  if command -v npiperelay.exe &>/dev/null; then
    command -v npiperelay.exe
    return
  fi
  shopt -s nullglob
  local matches=(
    /mnt/c/Users/*/AppData/Local/Microsoft/WinGet/Links/npiperelay.exe
    /mnt/c/Users/*/AppData/Local/Microsoft/WinGet/Packages/*npiperelay*/npiperelay.exe
  )
  shopt -u nullglob
  [[ ${#matches[@]} -gt 0 ]] && { echo "${matches[0]}"; return; }
  return 1
}

NPIPERELAY="$(find_npiperelay)" || {
  echo "npiperelay.exe not found — install with: winget install --id jstarks.npiperelay" >&2
  exit 1
}

if ! command -v socat &>/dev/null; then
  echo "socat not found — install with: sudo apt install -y socat" >&2
  exit 1
fi

mkdir -p "$(dirname "$SOCK")"
rm -f "$SOCK"

exec socat UNIX-LISTEN:"$SOCK",fork,umask=077 EXEC:"$NPIPERELAY -ei -s $PIPE",nofork
