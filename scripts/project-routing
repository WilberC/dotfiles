#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${NO_COLOR:-}" || "${TERM:-}" == "dumb" ]]; then
  RESET=''
  BOLD=''
  RED=''
  GREEN=''
  YELLOW=''
  CYAN=''
else
  RESET=$'\033[0m'
  BOLD=$'\033[1m'
  RED=$'\033[31m'
  GREEN=$'\033[32m'
  YELLOW=$'\033[33m'
  CYAN=$'\033[36m'
fi

info() { printf '%b%s%b\n' "${CYAN}${BOLD}" "$*" "$RESET"; }
success() { printf '%b✓%b %s\n' "${GREEN}${BOLD}" "$RESET" "$*"; }
warn() { printf '%b!%b %s\n' "${YELLOW}${BOLD}" "$RESET" "$*" >&2; }
error() { printf '%b✗%b %s\n' "${RED}${BOLD}" "$RESET" "$*" >&2; }

usage() {
  cat <<'EOF'
Usage: project-routing [--force] [--output FILE] [DIRECTORY]

Detecta repositorios Git en los hijos directos de DIRECTORY y genera un
AGENTS.md en el directorio objetivo. DIRECTORY es el directorio actual si se
omite.
EOF
}

force=0
output=
directory=

while (($# > 0)); do
  case "$1" in
    --force)
      force=1
      ;;
    --output)
      (($# >= 2)) || { error 'Falta el valor de --output'; exit 2; }
      output=$2
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -* )
      error "Opción desconocida: $1"
      usage >&2
      exit 2
      ;;
    *)
      [[ -z "$directory" ]] || { error 'Solo se admite un DIRECTORY'; exit 2; }
      directory=$1
      ;;
  esac
  shift
done

directory=${directory:-.}
directory=$(cd "$directory" && pwd -P)
output=${output:-$directory/AGENTS.md}

if [[ -e "$output" && "$force" -ne 1 ]]; then
  error "Ya existe $output; usa --force para reemplazarlo."
  exit 1
fi

declare -a repositories=()

# The three globs include normal and hidden direct children without recursing.
for child in "$directory"/* "$directory"/.[!.]* "$directory"/..?*; do
  [[ -d "$child" ]] || continue

  # git rev-parse also validates .git files used by worktrees and submodules.
  if repository_root=$(git -C "$child" rev-parse --show-toplevel 2>/dev/null); then
    child_name=${child#"$directory"/}
    git_entry="${child}/.git"
    if [[ -d "$git_entry" ]]; then
      git_kind="directory"
    else
      git_kind="file"
    fi
    repositories+=("$child_name|$repository_root|$git_kind")
  fi
done

mkdir -p "$(dirname "$output")"
{
  cat <<EOF
# Project routing instructions

<!-- Generated by project-routing. Do not edit manually. -->

This directory contains multiple direct child Git repositories. Before
modifying files, identify which child repository owns them and work from that
repository's root.

## Detected child repositories

EOF

  if ((${#repositories[@]} == 0)); then
    cat <<'EOF'
No direct child Git repositories were detected when this file was generated.

If the directory layout changes, regenerate this file.
EOF
  else
    printf '| Child | Repository root | `.git` |\n'
    printf '|---|---|---|\n'
    for repository in "${repositories[@]}"; do
      IFS='|' read -r child_name repository_root git_kind <<<"$repository"
      printf '| `%s/` | `%s` | %s |\n' "$child_name" "$repository_root" "$git_kind"
    done

    cat <<'EOF'

## Conditional instructions

- Do not load every child repository's instructions by default.
- When a task touches a child listed above, first read that child's
  `AGENTS.md` (if present) and its local configuration/documentation required
  for the task.
- Run Git commands, tests, package managers, and build tools from the owning
  child repository root.
- If a task touches more than one child repository, keep their changes and
  commits separate and report the affected repositories.
- Do not create a commit in this parent directory unless it is itself the
  intended repository for the requested change.
EOF
  fi
} >"$output"

success "Generated $output"
if ((${#repositories[@]} == 0)); then
  warn 'No direct child Git repositories found.'
else
  info "Detected ${#repositories[@]} direct child Git repositor$( [[ ${#repositories[@]} -eq 1 ]] && printf 'y' || printf 'ies' ):"
  for repository in "${repositories[@]}"; do
    IFS='|' read -r child_name _ _ <<<"$repository"
    printf '  %b→%b %s\n' "$CYAN" "$RESET" "$child_name"
  done
fi
