#!/bin/sh
set -eu

usage() {
    printf 'Usage: engram-cloud-link\n'
    printf '\nEnrolls the current directory name as an Engram Cloud project and syncs it.\n'
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
    '')
        ;;
    *)
        printf 'Unknown argument: %s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac

if ! command -v mise >/dev/null 2>&1; then
    printf 'mise was not found in PATH.\n' >&2
    exit 1
fi

engram() {
    mise exec -- engram "$@"
}

engram_env_file="${ENGRAM_ENV_FILE:-$HOME/dotfiles-secrets/secret-files/Personal/Engram/.env}"
if [ -z "${ENGRAM_CLOUD_SERVER:-}" ] && [ -f "$engram_env_file" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$engram_env_file"
    set +a
fi

if [ -z "${ENGRAM_CLOUD_SERVER:-}" ]; then
    printf 'ENGRAM_CLOUD_SERVER is not configured.\n' >&2
    exit 1
fi

project=$(basename "$PWD")

if [ -z "$project" ] || [ "$project" = "." ] || [ "$project" = ".." ]; then
    printf 'Could not determine the current directory name.\n' >&2
    exit 1
fi

printf '[engram] Linking current directory as project: %s\n' "$project"
printf '[engram] Configuring cloud server...\n'
engram cloud config --server "$ENGRAM_CLOUD_SERVER"
printf '[engram] Enrolling project...\n'
engram cloud enroll "$project"

printf '[engram] Syncing project...\n'
engram sync --cloud --project "$project"

printf '[engram] Cloud link complete: %s\n' "$project"
