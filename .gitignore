projects.conf

# SSH config groups are private-by-default: any *.conf here is ignored
# unless explicitly allowlisted below. New groups (anything with a
# matching *.conf.example, synced via scripts/ssh-config.sh) need no
# extra entry — only add a "!" line for files meant to be public.
shared/.config/ssh/configs/*.conf
!shared/.config/ssh/configs/01-base.conf
!shared/.config/ssh/configs/02-github.conf

# .pub files are regenerated from the 1Password SSH agent at install time
# (scripts/sync-ssh-pubs.sh) rather than committed, so a rotated key never
# leaves a stale file behind.
shared/.config/ssh/pubs/*.pub
__pycache__/
# Cargo build artifacts for Rust tools and crates.
target/
*known_hosts*
/linux/.local/bin
shared/.config/fish/fish_variables
shared/.config/zed/prompts/prompts-library-db.0.mdb/
